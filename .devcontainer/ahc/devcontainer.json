{
  "name": "cp-env for AHC",
  "build": {
    "dockerfile": "../../Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/cp-env,type=bind",
  "workspaceFolder": "/workspaces/cp-env/contest/AtCoder/AHC",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/workspaces/cp-env/tools"
  },
  // 環境変数が未設定のときは、エラーメッセージに変数名が出るよう、":" の後ろの文字列を代わりに入れる
  "mounts": [
    "source=${localEnv:CP_CONTEST_DIR:CP_CONTEST_DIR-is-not-set},target=/workspaces/cp-env/contest,type=bind",
    "source=${localEnv:CP_PROBLEMS_DIR:CP_PROBLEMS_DIR-is-not-set},target=/workspaces/cp-env/sakumon,type=bind",
    "source=cp-env-cache,target=/root/.cache,type=volume"
  ],
  // Competitive Companion がサンプルを送ってくるポート
  "appPort": [
    "127.0.0.1:10044:10044"
  ],
  "containerEnv": {
    "CPE_PORT": "10044",
    "CPE_MODE": "heuristic"
  },
  // gdb とサニタイザを動かすための設定
  "capAdd": [
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "init": true,
  // マウントしたリポジトリで git が「所有者が違う」と拒否するのを防ぐ
  "postCreateCommand": "git config --global --add safe.directory '*'",
  // サンプル受信を裏で動かし続ける。VS Code はこのコマンドを端末つきで実行し、終わると端末を閉じる。
  // そのときの SIGHUP で受信が消えることがある (起動直後で CPU が忙しいと起きやすい) ので、nohup で無視させる
  "postStartCommand": "nohup setsid -f sh -c 'cpe listen > /tmp/cpe-listen.log 2>&1' > /dev/null 2>&1",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/usr/local/bin/g++",
        "C_Cpp.default.cppStandard": "gnu++23",
        "C_Cpp.default.includePath": [
          "/workspaces/cp-env/library",
          "/opt/ac-library"
        ],
        "C_Cpp.default.defines": [
          "LOCAL"
        ],
        // 生成AI: アルゴリズム用のコンテナでは全部切る (ヒューリスティック用は手順13の別設定)
        "chat.disableAIFeatures": false,
        "github.copilot.enable": {
          "*": false,
          "cpp": true
        },
        "github.copilot.nextEditSuggestions.enabled": true,
        "chat.agent.enabled": false,
        // 設定用のフォルダは、ふだんはエクスプローラーに出さない (手入れのときは cpe focus --all で表示する)。
        // cpe focus がこの項目を書き換える。隠すものを変えるときは tools/cpe の ALWAYS_HIDDEN も直す
        "files.exclude": {
          "**/.vscode": true,
          "**/.devcontainer": true
        },
        // 整形: リポジトリ直下の .clang-format を使う
        "C_Cpp.formatting": "clangFormat",
        "C_Cpp.clang_format_style": "file",
        "[cpp]": {
          "editor.defaultFormatter": "ms-vscode.cpptools",
          "editor.formatOnSave": true
        },
        "workbench.colorCustomizations": {
          "statusBar.background": "#b45309",
          "statusBar.foreground": "#ffffff"
        }
      }
    }
  }
}
