#!/usr/bin/env python3
import argparse, hashlib, subprocess, sys, time, tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CACHE = Path.home() / ".cache" / "cpe"

def load_config() -> dict: ...                      # profiles.toml を読む
def pick_profile(cfg, src: Path, name=None) -> tuple[str, dict]: ...  # (設定名, 設定)
def build_command(cfg, prof, src: Path, out: Path, debug: bool) -> list[str]: ...
def compile_src(cfg, src: Path, name=None, debug=False) -> Path | None: ...  # 失敗時 None

def cmd_build(args) -> int: ...

def main() -> int:
    ap = argparse.ArgumentParser(prog="cpe")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("build")
    p.add_argument("src")
    p.add_argument("-p", "--profile")
    p.add_argument("-d", "--debug", action="store_true")
    p.set_defaults(func=cmd_build)
    args = ap.parse_args()
    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())
