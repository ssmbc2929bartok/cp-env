# ------------------------------------------------------------ 愚直解との突き合わせ
def cmd_stress(args) -> int:
    sol, naive, gen = (resolve_src(a) for a in (args.sol, args.naive, args.gen))
    cfg = load_config()
    tdir = tests_dir(sol)

    bins = []
    for path, debug in ((sol, args.debug), (naive, False), (gen, False)):
        b = compile_src(cfg, path, args.profile, debug, args.verbose, args.force)
        if b is None:
            return 1
        bins.append(str(b))
    sol_bin, naive_bin, gen_bin = bins

    # 時間制限: 解は test と同じ。愚直解は遅くて当然なので、長めに待つ
    tl = args.tl if args.tl else read_problem_info(tdir).get("timeLimit", 2000) / 1000
    sol_tl = tl * 10 if args.debug else tl
    naive_tl = max(10.0, tl * 10)
    live = sys.stdout.isatty()  # 端末なら、進み具合を同じ行に上書きして表示する
    cr = "\r\033[K" if live else ""  # 行頭に戻って、その行を消す

    def report(seed: int, title: str, data: bytes, expected: bytes | None, sections: list) -> int:
        """見つかった入力を tests/<ソース名>/stress-N に保存して、内容を表示する"""
        tdir.mkdir(parents=True, exist_ok=True)
        case = tdir / f"stress-{next_number(tdir, 'stress')}.in"
        case.write_bytes(data)
        if expected is not None:
            case.with_suffix(".out").write_bytes(expected)
        print(f"{cr}  #{seed}  {title}")
        for label, body in [("入力", decode(data))] + sections:
            print(dim(f"    --- {label} ---"))
            print(indent(clip(body)) if body.strip() else dim("    (出力なし)"))
        print(f"保存しました: {case}" + ("" if expected is None else " と .out (愚直解の出力)"))
        if expected is not None:
            print(dim(f"もう一度試すには: cpe test {sol.name} -c {case.stem}" + (" -d" if args.debug else "")))
        return 1

    done = 0
    try:
        while args.count <= 0 or done < args.count:
            seed = args.start + done  # 生成器には通し番号を引数で渡す (乱数の種に使う)
            status, data, err, _ = run_program([gen_bin, str(seed)], b"", 10.0)
            if status != "OK":
                print(f"{cr}  #{seed}  " + red(f"生成器が失敗しました: {status}"))
                print(dim(indent(clip(decode(err)))))
                return 2

            status, expected, err, _ = run_program([naive_bin], data, naive_tl)
            if status != "OK":
                sections = [("エラーの要約", "\n".join(summarize_error(decode(err), naive))),
                            ("標準エラー", decode(err))]
                return report(seed, yellow(f"愚直解が {status}"), data, None,
                              [s for s in sections if s[1].strip()])

            status, actual, err, _ = run_program([sol_bin], data, sol_tl)
            if status != "OK":
                sections = [("エラーの要約", "\n".join(summarize_error(decode(err), sol))),
                            ("愚直解の出力", decode(expected)), ("出力", decode(actual)),
                            ("標準エラー", decode(err))]
                return report(seed, yellow(status), data, expected,
                              [s for s in sections if s[1].strip() or s[0] == "出力"])
            if not same_output(decode(expected), decode(actual), args.eps):
                return report(seed, red("WA"), data, expected,
                              [("愚直解の出力", decode(expected)), ("出力", decode(actual))])

            done += 1
            if live:
                print(f"{cr}  #{seed}  一致 ({done} 件)", end="", flush=True)
            elif done % 100 == 0:
                print(f"  #{seed}  一致 ({done} 件)", flush=True)
    except KeyboardInterrupt:
        print(f"{cr}中断しました。{done} 件すべて一致")
        return 130
    print(cr + green(f"{done} 件すべて一致"))
    return 0


# ------------------------------------------------------------ 提出用に1ファイルへ展開する
_INCLUDE = re.compile(r'\s*#\s*include\s*(?:"([^"]+)"|<([^>]+)>)')
_PRAGMA_ONCE = re.compile(r"\s*#\s*pragma\s+once\b")


def acl_dirs() -> list[Path]:
    """ACL (atcoder/ フォルダ) の置き場所。Dockerfile が CPLUS_INCLUDE_PATH に入れている"""
    dirs = [Path(p) for p in os.environ.get("CPLUS_INCLUDE_PATH", "").split(os.pathsep) if p]
    return [d for d in dirs + [Path("/opt/ac-library")] if (d / "atcoder").is_dir()]


def expand_includes(src: Path, expand_acl: bool) -> tuple[str, int]:
    """自作ライブラリ (と ACL) の #include を中身に置き換える。(全文, 展開したファイル数) を返す。

    同じファイルは最初の1回だけ展開する (#pragma once と同じ扱い)。
    見つからないものと <bits/stdc++.h> などは、そのまま残す。
    """
    lib = ROOT / "library"
    acl = acl_dirs() if expand_acl else []
    seen = {src}
    out = []

    def find(name: str, quoted: bool, cur: Path) -> Path | None:
        cands = ([cur.parent / name] if quoted else []) + [lib / name]
        if name.startswith("atcoder/"):
            cands += [d / name for d in acl]
        return next((c.resolve() for c in cands if c.is_file()), None)

    def walk(path: Path) -> None:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            if _PRAGMA_ONCE.match(line):
                continue  # 1ファイルにまとめると不要 (残すと警告が出る)
            m = _INCLUDE.match(line)
            target = find(m.group(1) or m.group(2), bool(m.group(1)), path) if m else None
            if target is None:
                out.append(line)
            elif target not in seen:
                seen.add(target)
                walk(target)

    walk(src)
    return "\n".join(out) + "\n", len(seen) - 1


def cmd_bundle(args) -> int:
    src = resolve_src(args.src)
    cfg = load_config()
    pname, prof = pick_profile(cfg, src, args.profile)
    expand_acl = bool(prof.get("bundle_acl"))

    text, n_files = expand_includes(src, expand_acl)
    out = src.parent / "submit" / src.name  # ソースの隣に置くと、どちらが元か紛らわしいので分ける
    out.parent.mkdir(exist_ok=True)
    out.write_text(text, encoding="utf-8", newline="\n")
    note = f"{n_files} ファイルを展開" + (" (ACL を含む)" if expand_acl else "")
    print(f"[{pname}] {src.name} → {out}  ({note}、{text.count(chr(10))} 行)", flush=True)

    # 提出先と同じ条件でコンパイルできるかを確かめる:
    # LOCAL の定義なし、自作ライブラリなし、ACL を展開した場合は ACL もなし
    cmd = [CXX, f"-std={prof.get('std', 'gnu++23')}", *prof.get("flags", []),
           "-fsyntax-only", "-w", str(out)]
    env = dict(os.environ)
    if expand_acl:
        env.pop("CPLUS_INCLUDE_PATH", None)
    if args.verbose:
        print(" ".join(cmd))
    if subprocess.run(cmd, env=env).returncode != 0:
        print(red("提出用のファイルがコンパイルできません (上のエラーを確認してください)"), file=sys.stderr)
        return 1
    print(green("コンパイル確認 OK"))
    return 0


# ------------------------------------------------------------ サンプル受信 (Competitive Companion)
def series_of(contest_id: str) -> str:
    """AtCoder のコンテストIDからシリーズ名を作る: abc478 → ABC、awc0001 → AWC。
    「英字3文字 + 数字」以外 (typical90、adt_... など) は Others にまとめる"""
    m = re.fullmatch(r"([a-z]{3})(\d+)", contest_id)
    return m.group(1).upper() if m else "Others"


def locate(url: str, name: str = "") -> tuple[Path, str] | None:
    """問題の URL から (ソースを置くフォルダ, 問題名) を決める。
    対応サイトを増やすときは、ここに if を1つ足す。"""
    m = re.search(r"atcoder\.jp/contests/([^/]+)/tasks/([^/?#]+)", url)
    if m:
        cid, task = m.group(1).lower(), m.group(2).lower()
        series = series_of(cid)
        num = re.fullmatch(r"[a-z]{3}(\d+)", cid)
        folder = num.group(1) if (num and series != "Others") else cid  # abc478 → 478
        letter = task.rsplit("_", 1)[-1] if "_" in task else task  # abc478_c → c
        return CONTEST_ROOT / "AtCoder" / series / folder, letter.upper()
    m = (re.search(r"codeforces\.com/(?:contest|gym)/(\d+)/problem/(\w+)", url)
         or re.search(r"codeforces\.com/problemset/problem/(\d+)/(\w+)", url))
    if m:
        return CONTEST_ROOT / "Codeforces" / m.group(1), m.group(2).upper()
    m = re.search(r"yukicoder\.me/problems/no/(\d+)", url)
    if m:
        return CONTEST_ROOT / "yukicoder", m.group(1)
    host = re.sub(r"^https?://(www\.)?", "", url).split("/")[0] or "unknown"
    slug = re.sub(r"[^\w\-]+", "_", name.strip()).strip("_") or "problem"
    return CONTEST_ROOT / "Others" / host, slug


def is_heuristic(url: str) -> bool:
    """ヒューリスティック用のコンテナが担当する問題か (= AHC)"""
    m = re.search(r"atcoder\.jp/contests/([^/]+)/", url)
    return bool(m) and series_of(m.group(1).lower()) == "AHC"


def template_for(cfg: dict, src: Path, interactive: bool = False, name: str | None = None) -> str:
    """新しく作るソースの中身。templates/ に該当があれば使い、無ければ空。
    name を指定したときは、そのテンプレートを必ず使う (無ければエラー)"""
    if name:
        t = ROOT / "templates" / f"{name}.cpp"
        if not t.is_file():
            have = ", ".join(sorted(p.stem for p in (ROOT / "templates").glob("*.cpp")))
            die(f"テンプレート '{name}' は templates/ にありません (候補: {have})")
        return t.read_text(encoding="utf-8")
    pname, prof = pick_profile(cfg, src)
    names = (["interactive"] if interactive else []) + [prof.get("template", pname), "default"]
    for n in names:
        t = ROOT / "templates" / f"{n}.cpp"
        if t.is_file():
            return t.read_text(encoding="utf-8")
    return ""


def save_problem(cfg: dict, data: dict) -> tuple[Path, int, bool]:
    """受け取った問題を保存する。(ソースのパス, サンプル数, ソースを新しく作ったか) を返す"""
    url = data.get("url", "")
    folder, pname = locate(url, data.get("name", ""))
    src = folder / f"{pname}.cpp"
    tdir = tests_dir(src)
    tdir.mkdir(parents=True, exist_ok=True)

    interactive = bool(data.get("interactive"))
    created = False
    if not src.exists():  # 既に書きかけのソースがあれば、絶対に上書きしない
        src.write_text(template_for(cfg, src, interactive), encoding="utf-8", newline="\n")
        created = True

    # サンプルは毎回書き直す (前回の分は消す)。自作ケース (custom-*) などは残す
    for old in tdir.glob("sample-*"):
        old.unlink()
    tests = data.get("tests", [])
    for i, t in enumerate(tests, 1):
        (tdir / f"sample-{i}.in").write_text(t.get("input", ""), encoding="utf-8", newline="\n")
        (tdir / f"sample-{i}.out").write_text(t.get("output", ""), encoding="utf-8", newline="\n")

    info = {
        "name": data.get("name", ""),
        "url": url,
        "timeLimit": data.get("timeLimit", 2000),
        "memoryLimit": data.get("memoryLimit"),
        "interactive": interactive,
    }
    (tdir / "problem.json").write_text(json.dumps(info, ensure_ascii=False, indent=2) + "\n",
                                       encoding="utf-8", newline="\n")
    return src, len(tests), created


def cmd_listen(args) -> int:
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    cfg = load_config()
    mode = args.mode or MODE
    port = args.port or PORT
    if not CONTEST_ROOT.is_dir():
        die(f"{CONTEST_ROOT} がありません (コンテスト用フォルダのマウントを確認してください)")

    class Handler(BaseHTTPRequestHandler):
        def do_POST(self):
            now = time.strftime("%H:%M:%S")
            try:
                n = int(self.headers.get("Content-Length", "0"))
                data = json.loads(self.rfile.read(n).decode("utf-8"))
                url, name = data.get("url", ""), data.get("name", "?")
                mine = is_heuristic(url) == (mode == "heuristic")
                if not mine:
                    other = "アルゴリズム用" if mode == "heuristic" else "ヒューリスティック用"
                    print(dim(f"{now}  {name}: {other}のコンテナの担当なので保存しません"), flush=True)
                else:
                    src, cnt, created = save_problem(cfg, data)
                    rel = src.relative_to(CONTEST_ROOT) if src.is_relative_to(CONTEST_ROOT) else src
                    note = "新規作成" if created else "ソースは既存のまま"
                    print(f"{now}  {name}  → {rel}  (サンプル {cnt} 件、{note})", flush=True)
                self.send_response(200)
            except Exception as e:  # 1件失敗しても待ち受けは止めない
                print(red(f"{now}  受信エラー: {e}"), flush=True)
                self.send_response(400)
            self.end_headers()

        def log_message(self, *a):  # アクセスログは出さない
            pass

    try:
        server = ThreadingHTTPServer((args.host, port), Handler)
    except OSError as e:
        die(f"ポート {port} で待ち受けできません ({e})。既に cpe listen が動いていませんか?")
    print(f"待ち受け中: ポート {port} / 担当 {mode} / 保存先 {CONTEST_ROOT}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print()
    return 0


# ------------------------------------------------------------ VS Code の設定を配る
GENERATED_MARK = "cpe vscode が生成"


def vscode_targets() -> list[Path]:
    """.vscode/ を書き出す作業フォルダ (VS Code で一番上に表示するフォルダ)"""
    return [
        CONTEST_ROOT,  # アルゴリズム用のコンテナ
        CONTEST_ROOT / "AtCoder" / "AHC",  # ヒューリスティック用のコンテナ
        ROOT / "problems",  # 作問
        ROOT,  # cp-env 自体の手入れ
    ]


def cmd_vscode(args) -> int:
    src_dir = ROOT / "vscode"
    originals = sorted(p for p in src_dir.glob("*") if p.is_file()) if src_dir.is_dir() else []
    if not originals:
        die(f"原本がありません: {src_dir}/")
    ng = 0
    for target in vscode_targets():
        if not target.is_dir():
            print(dim(f"  {target}  (フォルダが無いので飛ばします)"))
            continue
        dest_dir = target / ".vscode"
        dest_dir.mkdir(exist_ok=True)
        for orig in originals:
            dest = dest_dir / orig.name
            body = orig.read_text(encoding="utf-8")
            mark = f"// {GENERATED_MARK}。ここを直接編集しないでください (原本: cp-env/vscode/{orig.name})\n"
            text = mark + body
            if dest.exists():
                old = dest.read_text(encoding="utf-8", errors="replace")
                if old == text:
                    print(dim(f"  {dest}  (変更なし)"))
                    continue
                if GENERATED_MARK not in old and not args.force:
                    # 自分で書いた設定を消さないよう、cpe が作ったもの以外は上書きしない
                    print(yellow(f"  {dest}  (自作のファイルがあるので飛ばしました。上書きするなら -f)"))
                    ng += 1
                    continue
            dest.write_text(text, encoding="utf-8", newline="\n")
            print(f"  {dest}  書き出しました")
    return 1 if ng else 0


def cmd_warmup(args) -> int:
    """全設定 (通常・デバッグ) の <bits/stdc++.h> を事前コンパイルする。コンテスト前の準備用"""
    cfg = load_config()
    done = {}
    for pname, prof in cfg.get("profile", {}).items():
        for debug in (False, True):
            flags = compile_flags(cfg, prof, debug)
            key = tuple(flags)
            label = f"{pname}{'/debug' if debug else ''}"
            if key in done:  # 同じフラグの組は1つで足りる
                print(f"  {label:<18} {dim('(' + done[key] + ' と共通)')}")
                continue
            t0 = time.time()
            ok = ensure_pch(flags, quiet=True) is not None
            done[key] = label
            res = green("OK") if ok else red("失敗 (通常のコンパイルで動きます)")
            print(f"  {label:<18} {res}  {time.time() - t0:.1f}s", flush=True)
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="cpe", description="競プロ環境コマンド")
    sub = ap.add_subparsers(dest="cmd", required=True)

    src_help = "ソースファイル (省略時は、今いるフォルダで最後に保存した .cpp)"

    p = sub.add_parser("build", aliases=["b"], help="コンパイルだけする")
    p.add_argument("src", nargs="?", help=src_help)
    p.add_argument("-p", "--profile", help="設定名 (省略時はパスから判定)")
    p.add_argument("-d", "--debug", action="store_true", help="デバッグ用フラグでコンパイル")
    p.add_argument("-v", "--verbose", action="store_true", help="コンパイルコマンドを表示")
    p.add_argument("-f", "--force", action="store_true", help="変更がなくてもコンパイルし直す")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("test", aliases=["t"], help="tests/<ソース名>/ のケースを全部流して判定する")
    p.add_argument("src", nargs="?", help=src_help)
    p.add_argument("-p", "--profile", help="設定名 (省略時はパスから判定)")
    p.add_argument("-d", "--debug", action="store_true", help="デバッグ用フラグでコンパイル")
    p.add_argument("-c", "--case", action="append", help="実行するケース名 (ワイルドカード・部分一致可、複数指定可)")
    p.add_argument("-e", "--eps", type=float, default=1e-6, help="小数の許容誤差 (既定 1e-6、0 で厳密比較)")
    p.add_argument("-t", "--tl", type=float, help="時間制限 [秒] (既定は problem.json、無ければ 2)")
    p.add_argument("-v", "--verbose", action="store_true", help="AC のケースも入出力を表示")
    p.add_argument("-f", "--force", action="store_true", help="変更がなくてもコンパイルし直す")
    p.set_defaults(func=cmd_test)

    p = sub.add_parser("run", aliases=["r"], help="コンパイルして実行する (標準入力をそのまま渡す)")
    p.add_argument("src", nargs="?", help=src_help)
    p.add_argument("-i", "--input", help="入力ファイル、または tests/<ソース名>/ のケース名 (sample-1 など)")
    p.add_argument("-p", "--profile", help="設定名 (省略時はパスから判定)")
    p.add_argument("-d", "--debug", action="store_true", help="デバッグ用フラグでコンパイル")
    p.add_argument("-v", "--verbose", action="store_true", help="コンパイルコマンドを表示")
    p.add_argument("-f", "--force", action="store_true", help="変更がなくてもコンパイルし直す")
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("add", help="自作の入力 tests/<ソース名>/custom-N.in を足す (貼り付けて Ctrl+D)")
    p.add_argument("src", nargs="?", help=src_help)
    p.add_argument("-o", "--out", action="store_true", help="期待する出力 (custom-N.out) も続けて貼り付ける")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("new", help="テンプレートからソースを作る (既にあるファイルは上書きしない)")
    p.add_argument("files", nargs="+", metavar="ファイル", help="作るソース (.cpp は省略可、複数指定可)")
    p.add_argument("-t", "--template", help="テンプレート名 (省略時はパスから判定。templates/<名前>.cpp)")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser("stress", help="解と愚直解の出力が食い違う入力を、乱数で探す")
    p.add_argument("sol", help="調べたい解")
    p.add_argument("naive", help="愚直解 (遅くても正しい解)")
    p.add_argument("gen", help="入力の生成器 (引数に通し番号を受け取り、入力を標準出力に書く)")
    p.add_argument("-n", "--count", type=int, default=0, help="試す回数 (既定は、食い違うか Ctrl+C で止めるまで)")
    p.add_argument("-s", "--start", type=int, default=1, help="生成器に渡す通し番号の最初の値 (既定 1)")
    p.add_argument("-p", "--profile", help="設定名 (省略時はパスから判定)")
    p.add_argument("-d", "--debug", action="store_true", help="解をデバッグ用フラグでコンパイル")
    p.add_argument("-e", "--eps", type=float, default=1e-6, help="小数の許容誤差 (既定 1e-6、0 で厳密比較)")
    p.add_argument("-t", "--tl", type=float, help="解の時間制限 [秒] (既定は problem.json、無ければ 2)")
    p.add_argument("-v", "--verbose", action="store_true", help="コンパイルコマンドを表示")
    p.add_argument("-f", "--force", action="store_true", help="変更がなくてもコンパイルし直す")
    p.set_defaults(func=cmd_stress)

    p = sub.add_parser("bundle", help="#include を展開して、提出用の submit/<ソース名>.cpp を作る")
    p.add_argument("src", nargs="?", help=src_help)
    p.add_argument("-p", "--profile", help="設定名 (省略時はパスから判定。ACL を展開するかが決まる)")
    p.add_argument("-v", "--verbose", action="store_true", help="確認用のコンパイルコマンドを表示")
    p.set_defaults(func=cmd_bundle)

    p = sub.add_parser("warmup", help="<bits/stdc++.h> を全設定分、先にコンパイルしておく")
    p.set_defaults(func=cmd_warmup)

    p = sub.add_parser("listen", help="Competitive Companion からサンプルを受け取って保存する")
    p.add_argument("--port", type=int, help="待ち受けるポート (既定は環境変数 CPE_PORT)")
    p.add_argument("--mode", choices=["algorithm", "heuristic"], help="担当 (既定は環境変数 CPE_MODE)")
    p.add_argument("--host", default="0.0.0.0", help="待ち受けるアドレス (コンテナ内では 0.0.0.0)")
    p.set_defaults(func=cmd_listen)

    p = sub.add_parser("vscode", help="cp-env/vscode/ の原本を、各作業フォルダの .vscode/ に書き出す")
    p.add_argument("-f", "--force", action="store_true", help="自作のファイルがあっても上書きする")
    p.set_defaults(func=cmd_vscode)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:  # Ctrl-C で止めたとき、長いエラー表示を出さない
        sys.exit(130)
    except BrokenPipeError:  # | head などで出力を途中で切ったとき
        sys.exit(0)
