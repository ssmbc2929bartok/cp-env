{
  // VS Code のタスク (原本)。cpe vscode で各作業フォルダの .vscode/ に書き出す。
  // Ctrl+Shift+B で「cpe: test」が動く。それ以外は「タスクの実行」から選ぶ。
  // コンパイルエラーを「問題」に出すパターンは、C/C++ 拡張の $gcc と同じものを直接書いている。
  // $gcc を使うと、コンテナを作った直後 (拡張のインストールが終わる前) にエラーになるため。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cpe: test",
      "detail": "開いているファイルのサンプルを全部流して判定する",
      "type": "process",
      "command": "cpe",
      "args": ["test", "${file}"],
      "options": { "cwd": "${fileDirname}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false },
      "problemMatcher": {
        "owner": "cpe", "source": "g++", "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "cpe: test (debug)",
      "detail": "デバッグ用フラグ (配列外参照などを検出) で判定する",
      "type": "process",
      "command": "cpe",
      "args": ["test", "${file}", "-d"],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false },
      "problemMatcher": {
        "owner": "cpe", "source": "g++", "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "cpe: build",
      "detail": "コンパイルだけする",
      "type": "process",
      "command": "cpe",
      "args": ["build", "${file}"],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false },
      "problemMatcher": {
        "owner": "cpe", "source": "g++", "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "cpe: bundle",
      "detail": "提出用に #include を展開して submit/ に書き出す",
      "type": "process",
      "command": "cpe",
      "args": ["bundle", "${file}"],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false },
      "problemMatcher": {
        "owner": "cpe", "source": "g++", "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "cpe: run",
      "detail": "実行して、ターミナルから入力を手で渡す (インタラクティブ問題など)",
      "type": "process",
      "command": "cpe",
      "args": ["run", "${file}"],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "problemMatcher": {
        "owner": "cpe", "source": "g++", "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "cpe: fetch",
      "detail": "次に受信する1問を、開いているファイルの問題として受け取る (drill など、好きな名前で解くとき)",
      "type": "process",
      "command": "cpe",
      "args": ["fetch", "${file}"],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": false },
      "problemMatcher": []
    },
    {
      "label": "cpe: add",
      "detail": "自作の入力を足す (ターミナルに貼り付けて Ctrl+D)",
      "type": "process",
      "command": "cpe",
      "args": ["add", "${file}"],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "problemMatcher": []
    }
  ]
}
